# --- ember-kimi-audit live config -------------------------------------------
# Copy to .env and fill in. .env is gitignored — never commit secrets.
# .env.example is the committed template.

# ProjectDiscovery tools (pd-mcp lane). Local install on the bridge box.
PD_TOOLS_DIR=/home/toxic/.pdtm/go/bin

# pd-mcp one-shot caller (yote). Usage:
#   yote-conn exec 'cd /home/toxic/pd-mcp-kestrel && PD_TOOLS_DIR=/home/toxic/.pdtm/go/bin bun pd-call.ts httpx '\''{"targets":["https://example.com"],"tech_detect":true}'\'
PD_MCP_DIR=/home/toxic/pd-mcp-kestrel

# Exa neural search CLI (cell). Auth via vault credential, never paste a key here.
EXA_CLI=/home/hatch/workspace/skills/exa/bin/exa.py

# Targets under audit
AUDIT_ARTICLE_URL=https://thenewstack.io/ember1-kimik3-speed-comparison/
AUDIT_FIREWORKS_BLOG=https://fireworks.ai/blog/ember-1
